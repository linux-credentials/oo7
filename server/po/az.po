#: ../src/gnome/prompter.rs:151
msgid "Change Keyring Password"
msgstr "Açarlığın parolunu dəyişin"

#: ../src/gnome/prompter.rs:152
#, rust-format
msgid "Choose a new password for the “{}” keyring"
msgstr "“{}” açarlığı üçün yeni parol seçin"

#: ../src/gnome/prompter.rs:155 ../src/prompt/mod.rs:408
#, rust-format
msgid ""
"An application wants to change the password for the “{}” keyring. Choose the "
"new password you want to use for it."
msgstr ""
"Bir tətbiq “{}” açarlığının parolunu dəyişmək istəyir. Bu açarlıq üçün "
"istifadə etmək istədiyiniz yeni parolu seçin."

#: ../src/gnome/prompter.rs:160
msgid "This operation cannot be reverted"
msgstr "Bu əməliyyatı geri qaytarmaq mümkün deyil"

#: ../src/gnome/prompter.rs:166
msgid "Continue"
msgstr "Davam et"

#: ../src/gnome/prompter.rs:167 ../src/gnome/prompter.rs:193
#: ../src/gnome/prompter.rs:215
msgid "Cancel"
msgstr "Ləğv et"

#: ../src/gnome/prompter.rs:177
msgid "Unlock Keyring"
msgstr "Açarlığın kilidini açın"

#: ../src/gnome/prompter.rs:178
msgid "Authentication required"
msgstr "Kimliyin təsdiqlənməsi tələb olunur"

#: ../src/gnome/prompter.rs:181 ../src/prompt/mod.rs:398
#, rust-format
msgid "An application wants access to the keyring “{}”, but it is locked"
msgstr "Bir tətbiq “{}” açarlığına giriş istəyir, lakin açarlıq kilidlidir"

#: ../src/gnome/prompter.rs:192
msgid "Unlock"
msgstr "Kilidi aç"

#: ../src/gnome/prompter.rs:199
msgid "New Keyring Password"
msgstr "Yeni açarlıq parolu"

#: ../src/gnome/prompter.rs:200
msgid "Choose password for new keyring"
msgstr "Yeni açarlıq üçün parol seçin"

#: ../src/gnome/prompter.rs:203 ../src/prompt/mod.rs:403
#, rust-format
msgid ""
"An application wants to create a new keyring called “{}”. Choose the "
"password you want to use for it."
msgstr ""
"Bir tətbiq “{}” adlı yeni açarlıq yaratmaq istəyir. Bu açarlıq üçün "
"istifadə etmək istədiyiniz parolu seçin."

#: ../src/gnome/prompter.rs:214
msgid "Create"
msgstr "Yarat"

#: ../src/plasma/prompter.rs:230
msgid "The unlock password was incorrect"
msgstr "Kilidi açmaq üçün daxil edilən parol yanlışdır"
