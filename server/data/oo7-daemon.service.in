[Unit]
Description=Secret service (oo7 implementation)

[Service]
Type=dbus
BusName=@dbus_known_name@
StandardError=journal
ExecStart=@libexecdir@/@binary@
Restart=on-failure
TimeoutStartSec=30s
TimeoutStopSec=30s
ImportCredential=oo7.keyring-encryption-password

# Prevent privilege escalation (blocks suid, new caps, etc.)
NoNewPrivileges=@no_new_privileges@

# Clear supplementary groups
SupplementaryGroups=
PrivateUsers=@private_users@

# Restrict filesystem access
ProtectSystem=full
PrivateTmp=yes
PrivateDevices=yes

# No network needed
PrivateNetwork=yes

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
MemoryDenyWriteExecute=@memory_deny_write_execute@
ProtectClock=yes

[Install]
WantedBy=default.target
